# Server-only model configuration. Never expose DEEPSEEK_API_KEY to Vite/client variables.
DEEPSEEK_API_KEY=
QL_INTENT_MODEL=deepseek-v4-flash
QL_REASONING_MODEL=deepseek-v4-flash
QL_INTENT_TIMEOUT_MS=7000
QL_REASONING_TIMEOUT_MS=7000

# Per-runtime API write limit. A distributed binding replaces this at multi-instance scale.
QL_RATE_LIMIT_MAX=30
QL_RATE_LIMIT_WINDOW_MS=60000

# Stage 2 Evidence review API. Keep false until Supabase Auth, MFA, grants,
# migration, durable backups, and a controlled reviewer rehearsal are verified.
QL_EVIDENCE_REVIEW_API_ENABLED=false
QL_EVIDENCE_REVIEW_PROVIDER=supabase
QL_EVIDENCE_REVIEW_SCOPE_ID=evidence-v1.0-huangpu-10
QL_SUPABASE_PROJECT_URL=
# Server-only service_role JWT. Never expose through VITE_* or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Local reviewer Auth/MFA bootstrap UI. The publishable/anon key is browser-safe;
# never place a service-role or sb_secret_ key in either VITE_ variable.
VITE_QL_SUPABASE_PROJECT_URL=
VITE_QL_SUPABASE_PUBLISHABLE_KEY=

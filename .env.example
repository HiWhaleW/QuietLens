# Server-only model configuration. Never expose DEEPSEEK_API_KEY to Vite/client variables.
DEEPSEEK_API_KEY=
QL_INTENT_MODEL=deepseek-v4-flash
QL_REASONING_MODEL=deepseek-v4-flash
QL_INTENT_TIMEOUT_MS=7000
QL_REASONING_TIMEOUT_MS=7000

# Per-runtime API write limit. A distributed binding replaces this at multi-instance scale.
QL_RATE_LIMIT_MAX=30
QL_RATE_LIMIT_WINDOW_MS=60000
